# Copy this file to  .env  (same folder as package.json) and fill it in. Restart `npm start` afterwards.
# This is the PUBLIC form URL from Formspree (https://formspree.io) - it is not a secret and holds no password.
# The inbox that receives messages is set inside your Formspree dashboard, not in this app.
REACT_APP_FORMSPREE_ENDPOINT=https://formspree.io/f/mzedgyqk
